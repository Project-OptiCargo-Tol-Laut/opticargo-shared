{
  "$defs": {
    "ModelMode": {
      "enum": [
        "trained",
        "heuristic"
      ],
      "title": "ModelMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anomaly_score": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Anomaly Score",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "entity_id": {
      "format": "uuid",
      "title": "Entity Id",
      "type": "string"
    },
    "entity_type": {
      "title": "Entity Type",
      "type": "string"
    },
    "is_anomaly": {
      "title": "Is Anomaly",
      "type": "boolean"
    },
    "model_mode": {
      "$ref": "#/$defs/ModelMode"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    }
  },
  "required": [
    "correlation_id",
    "entity_type",
    "entity_id",
    "is_anomaly",
    "anomaly_score",
    "model_mode"
  ],
  "title": "AnomalyResponse",
  "type": "object"
}
