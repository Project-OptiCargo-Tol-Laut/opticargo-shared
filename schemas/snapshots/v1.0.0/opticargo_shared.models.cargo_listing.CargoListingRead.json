    "supplier_id": {
      "format": "uuid",
      "title": "Supplier Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "volume_ton": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Volume Ton",
      "type": "string"
    }
