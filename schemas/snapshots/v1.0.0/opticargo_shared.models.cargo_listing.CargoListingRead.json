  "required": [
    "supplier_id",
    "commodity_id",
    "volume_ton",
    "available_from",
    "available_until",
    "origin_port_id",
    "destination_port_id",
    "asking_price_per_ton",
    "id",
    "created_at",
    "updated_at"
