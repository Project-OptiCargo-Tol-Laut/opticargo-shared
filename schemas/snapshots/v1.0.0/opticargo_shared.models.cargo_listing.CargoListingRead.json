      "type": "string"
    },
    "available_from": {
      "format": "date",
      "title": "Available From",
      "type": "string"
    },
    "available_until": {
      "format": "date",
      "title": "Available Until",
      "type": "string"
    },
    "commodity_id": {
      "format": "uuid",
      "title": "Commodity Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "destination_port_id": {
      "format": "uuid",
      "title": "Destination Port Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "origin_port_id": {
      "format": "uuid",
      "title": "Origin Port Id",
      "type": "string"
    },
    "status": {
