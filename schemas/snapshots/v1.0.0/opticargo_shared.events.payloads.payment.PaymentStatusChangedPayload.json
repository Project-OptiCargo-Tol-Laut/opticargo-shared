{
  "$defs": {
    "PaymentStatus": {
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "title": "PaymentStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "amount": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Amount",
      "type": "string"
    },
    "booking_id": {
      "format": "uuid",
      "title": "Booking Id",
      "type": "string"
    },
    "external_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Reference"
    },
    "new_status": {
      "$ref": "#/$defs/PaymentStatus"
    },
    "payment_id": {
      "format": "uuid",
      "title": "Payment Id",
      "type": "string"
    },
    "previous_status": {
      "$ref": "#/$defs/PaymentStatus"
    },
    "provider_event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Event Id"
    }
  },
  "required": [
    "payment_id",
    "booking_id",
    "previous_status",
    "new_status",
    "amount"
  ],
  "title": "PaymentStatusChangedPayload",
  "type": "object"
}
