{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Version"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "source_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "title"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ConfidenceLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "ModelMode": {
      "enum": [
        "trained",
        "heuristic"
      ],
      "title": "ModelMode",
      "type": "string"
    },
    "QueryIntent": {
      "enum": [
        "regulation",
        "matching",
        "route",
        "analytics",
        "unknown"
      ],
      "title": "QueryIntent",
      "type": "string"
    },
    "RankedRecommendation": {
      "additionalProperties": false,
      "properties": {
        "cargo_listing_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Cargo Listing Ids",
          "type": "array"
        },
        "estimated_cost": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost"
        },
        "estimated_revenue": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Revenue"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "recommended_action": {
          "title": "Recommended Action",
          "type": "string"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "score": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Score",
          "type": "string"
        },
        "score_breakdown": {
          "$ref": "#/$defs/ScoreBreakdown"
        }
      },
      "required": [
        "rank",
        "score",
        "score_breakdown",
        "recommended_action"
      ],
      "title": "RankedRecommendation",
      "type": "object"
    },
    "ScoreBreakdown": {
      "additionalProperties": false,
      "properties": {
        "capacity_fit": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Capacity Fit",
          "type": "string"
        },
        "distance_fit": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Distance Fit",
          "type": "string"
        },
        "economic_value": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Economic Value",
          "type": "string"
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        },
        "model_mode": {
          "$ref": "#/$defs/ModelMode"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "risk_score": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Risk Score",
          "type": "string"
        },
        "schedule_fit": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Schedule Fit",
          "type": "string"
        },
        "supplier_rating": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supplier Rating"
        },
        "total_score": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Total Score",
          "type": "string"
        }
      },
      "required": [
        "total_score",
        "economic_value",
        "schedule_fit",
        "capacity_fit",
        "distance_fit",
        "risk_score",
        "model_mode"
      ],
      "title": "ScoreBreakdown",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abstained": {
      "default": false,
      "title": "Abstained",
      "type": "boolean"
    },
    "abstention_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstention Reason"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "confidence": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Confidence",
      "type": "string"
    },
    "confidence_level": {
      "$ref": "#/$defs/ConfidenceLevel"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "fallback_used": {
      "default": false,
      "title": "Fallback Used",
      "type": "boolean"
    },
    "intent": {
      "$ref": "#/$defs/QueryIntent"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/RankedRecommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "voyage_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voyage Id"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "correlation_id",
    "intent",
    "summary",
    "confidence",
    "confidence_level"
  ],
  "title": "RecommendationOutput",
  "type": "object"
}
