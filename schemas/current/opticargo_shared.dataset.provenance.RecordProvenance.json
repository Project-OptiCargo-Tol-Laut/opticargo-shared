{
  "$defs": {
    "ValidationStatus": {
      "enum": [
        "pending",
        "valid",
        "invalid"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "collected_or_generated_at": {
      "format": "date-time",
      "title": "Collected Or Generated At",
      "type": "string"
    },
    "generator_seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generator Seed"
    },
    "is_synthetic": {
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "original_external_identifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original External Identifier"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "transformation_version": {
      "minLength": 1,
      "title": "Transformation Version",
      "type": "string"
    },
    "validation_status": {
      "$ref": "#/$defs/ValidationStatus"
    }
  },
  "required": [
    "source",
    "collected_or_generated_at",
    "transformation_version",
    "is_synthetic",
    "validation_status"
  ],
  "title": "RecordProvenance",
  "type": "object"
}
