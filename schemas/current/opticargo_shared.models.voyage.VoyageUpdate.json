{
  "$defs": {
    "VoyageStatus": {
      "enum": [
        "scheduled",
        "in_transit",
        "completed",
        "cancelled",
        "delayed"
      ],
      "title": "VoyageStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "arrival_date": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arrival Date"
    },
    "departure_date": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Departure Date"
    },
    "remaining_capacity_ton": {
      "anyOf": [
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remaining Capacity Ton"
    },
    "route_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Route Id"
    },
    "ship_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ship Id"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/VoyageStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "total_capacity_ton": {
      "anyOf": [
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Capacity Ton"
    },
    "used_capacity_ton": {
      "anyOf": [
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Used Capacity Ton"
    },
    "waypoints": {
      "anyOf": [
        {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Waypoints"
    }
  },
  "title": "VoyageUpdate",
  "type": "object"
}
