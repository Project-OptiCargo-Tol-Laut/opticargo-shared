    "AccountStatus": {
      "enum": [
        "pending",
        "active",
        "suspended",
        "disabled"
      ],
      "title": "AccountStatus",
      "type": "string"
    },
    "UserRole": {
      "enum": [
        "admin",
        "operator_kapal",
        "distributor",
        "umkm",
        "pengepul",
        "koperasi",
        "pelabuhan",
        "pemerintah",
        "eksportir",
        "operator_kapal"
      ],
      "title": "UserRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
