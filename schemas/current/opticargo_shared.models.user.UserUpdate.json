    "username": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Username"
    }
  },
  "title": "UserUpdate",
  "type": "object"
