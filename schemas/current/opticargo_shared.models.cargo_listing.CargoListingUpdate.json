{
  "$defs": {
    "CargoListingStatus": {
      "enum": [
        "open",
        "matched",
        "closed",
        "expired"
      ],
      "title": "CargoListingStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asking_price_per_ton": {
      "anyOf": [
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asking Price Per Ton"
    },
    "available_from": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Available From"
    },
    "available_until": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Available Until"
    },
    "destination_port_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Destination Port Id"
    },
    "origin_port_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Origin Port Id"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/CargoListingStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "volume_ton": {
      "anyOf": [
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Volume Ton"
    }
  },
  "title": "CargoListingUpdate",
  "type": "object"
}
